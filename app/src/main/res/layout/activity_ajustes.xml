<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- ============ CABECERA ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/botonAtras"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/desc_atras"
            android:src="@drawable/ic_atras" />

        <TextView
            style="@style/Nudo.Titular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_weight="1"
            android:text="@string/ajustes_titulo"
            android:textSize="19sp" />
    </LinearLayout>

    <!-- ============ ESTE DISPOSITIVO ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/fondo_tarjeta"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Nudo.Maquina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.06"
            android:text="@string/ajustes_este_dispositivo"
            android:textAllCaps="true"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/nombreDispositivo"
            style="@style/Nudo.Titular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="17sp"
            tools:text="Google Pixel 9" />

        <TextView
            style="@style/Nudo.Maquina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:lineSpacingExtra="2dp"
            android:text="@string/ajustes_credencial_explicacion"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- ============ RETIRARSE ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/fondo_tarjeta"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/Nudo.Titular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/ajustes_retirarse_titulo"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/detalleRetirarse"
            style="@style/Nudo.Maquina"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:textSize="12sp"
            tools:text="Se borrarán 6 conversaciones. No hay copia en el móvil." />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <Button
                android:id="@+id/botonRetirarse"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/ajustes_retirarse_accion"
                android:textColor="@color/nudo_hilo"
                app:strokeColor="@color/nudo_hilo" />

            <ProgressBar
                android:id="@+id/progresoRetirada"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
