<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/fondo_tarjeta"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="15dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tituloItem"
            style="@style/Nudo.Titular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="17sp"
            tools:text="Tutoría del TFG con Alberto" />

        <TextView
            android:id="@+id/metaItem"
            style="@style/Nudo.Maquina"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:textSize="11sp"
            tools:text="16 jul · 20:14" />
    </LinearLayout>

    <TextView
        android:id="@+id/pildoraItem"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/fondo_pildora"
        android:paddingHorizontal="11dp"
        android:paddingVertical="5dp"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="atada" />
</LinearLayout>
