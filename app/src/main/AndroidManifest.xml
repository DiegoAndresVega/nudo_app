<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      allowBackup="false": en el móvil viven el token de este dispositivo y las
      conversaciones ya transcritas, y con la copia automática activa acabarían
      saliendo del móvil dentro de un respaldo de Google Drive.

      Sigue haciendo falta aunque ahora todo eso vaya cifrado contra el Keystore
      (ver Cofre.kt): la clave no sale del móvil, así que un respaldo restaurado
      en otro dispositivo sería ilegible. Dejar que se copie sería mandar fuera
      un dato sensible para nada.
    -->
    <application
        android:name=".NudoApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Nudo">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ConversacionActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".AjustesActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
    </application>

</manifest>
